# Copy this file to `.env` and fill in the values from your Supabase project
# (Dashboard > Project Settings > API). See docs/SUPABASE.md.
#
# Leave these unset and the app runs entirely on-device with sample data,
# which is the right setup for a demo you do not want to configure.
#
# Only the `anon` key belongs here. It is public by design and safe in a
# shipped app *because* Row Level Security is enabled on every table. Never
# put the `service_role` key in a client - it bypasses RLS completely.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
