# Optional. The project every build uses is already set in app.json
# (expo.extra.supabase). Copy this file to `.env` only to point your own
# machine at a different Supabase project - values here override app.json.
# Find them under Dashboard > Project Settings > API. See docs/SUPABASE.md.
#
# There is no on-device fallback: with no project in either place the app
# shows a "not connected to a database" screen.
#
# Only the `anon` key belongs here. It is public by design and safe in a
# shipped app *because* Row Level Security is enabled on every table. Never
# put the `service_role` key in a client - it bypasses RLS completely.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
